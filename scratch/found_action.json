            "ReplacementContent": "    <style>\n    .qc-img-upload-area { display: flex; gap: 10px; flex-wrap: wrap; }\n    .qc-img-box { width: 80px; height: 80px; border: 2px dashed #cbd5e1; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; background: #f8fafc; }\n    .qc-img-box.has-image { border-style: solid; border-color: transparent; }\n    .qc-img-box img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 1; }\n    .qc-img-box .remove-img { position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 50%; width: 20px; height: 20px; font-size: 14px; cursor: pointer; z-index: 2; display: flex; align-items: center; justify-content: center; line-height: 1; opacity: 0; transition: 0.2s; }\n    .qc-img-box:hover .remove-img { opacity: 1; }\n    .qc-img-add-btn { width: 80px; height: 80px; border: 2px dashed #cbd5e1; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; background: #f8fafc; color: #94a3b8; transition: 0.2s; font-size: 12px; }\n    .qc-img-add-btn:hover { background: #f1f5f9; border-color: #94a3b8; }\n    .qc-img-add-btn svg { width: 24px; height: 24px; margin-bottom: 4px; stroke: currentColor; fill: none; stroke-width: 2; }\n    <\/style>\n    <script>\n    function openAdminQcForm(reqId, reqUserId, offUserId) {\n        document.getElementById('qc_request_id').value = reqId;\n        document.getElementById('qc_requester_id').value = reqUserId;\n        document.getElementById('qc_offer_id').value = offUserId;\n        document.getElementById('adminQcFormModal').style.display = 'flex';\n    }\n\n    function setupQcImageUpload(inputId, previewAreaId) {\n        const input = document.getElementById(inputId);\n        const previewArea = document.getElementById(previewAreaId);\n        let selectedFiles = [];\n\n        input.addEventListener('change', (e) => {\n            const files = Array.from(e.target.files);\n            selectedFiles = selectedFiles.concat(files);\n            updateInputAndPreview();\n        });\n\n        function updateInputAndPreview() {\n            const dt = new DataTransfer();\n            selectedFiles.forEach(file => dt.items.add(file));\n            input.files = dt.files;\n\n            previewArea.innerHTML = '';\n            \n            selectedFiles.forEach((file, index) => {\n                const box = document.createElement('div');\n                box.className = 'qc-img-box has-image';\n                const img = document.createElement('img');\n                img.src = URL.createObjectURL(file);\n                const removeBtn = document.createElement('button');\n                removeBtn.type = 'button';\n                removeBtn.className = 'remove-img';\n                removeBtn.innerHTML = '&times;';\n                removeBtn.onclick = (e) => {\n                    e.stopPropagation();\n                    e.preventDefault();\n                    selectedFiles.splice(index, 1);\n                    updateInputAndPreview();\n                };\n                box.appendChild(img);\n                box.appendChild(removeBtn);\n                previewArea.appendChild(box);\n            });\n\n            const addLabel = document.createElement('label');\n            addLabel.className = 'qc-img-add-btn';\n            addLabel.setAttribute('for', inputId);\n            addLabel.innerHTML = `<svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14m-7-7h14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><span>เพิ่มรูป<\/span>`;\n            \n            addLabel.addEventListener('dragover', e => { e.preventDefault(); addLabel.style.borderColor = '#b66f68'; addLabel.style.color = '#b66f68'; });\n            addLabel.addEventListener('dragleave', e => { e.preventDefault(); addLabel.style.borderColor = ''; addLabel.style.color = ''; });\n            addLabel.addEventListener('drop', e => {\n                e.preventDefault();\n                addLabel.style.borderColor = ''; addLabel.style.color = '';\n                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {\n                    const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image\/'));\n                    selectedFiles = selectedFiles.concat(files);\n                    updateInputAndPreview();\n                }\n            });\n\n            previewArea.appendChild(addLabel);\n        }\n        \n        updateInputAndPreview();\n    }\n    \n    document.addEventListener('DOMContentLoaded', () => {\n        setupQcImageUpload('req_photos_input', 'req_photos_preview');\n        setupQcImageUpload('off_photos_input', 'off_photos_preview');\n    });\n    <\/script>",
